node_modules/
burner.json
.cc-executor.env
# ...and every backup/rotation variant. A `.cc-executor.env.bak-battery` copy was
# sitting untracked beside it, which one `git add -A` would have published.
.cc-executor.env.*
.cc-executor.sqlite*
.cc-executor.lock
PAUSE_ENTRIES
HARD_STOP

# Rollback copies written by macos-release.sh carry the feed secret and RPC keys;
# the manual round-trip probe keeps its own journal. Neither may ever be staged.
.cc-executor.env.previous-*
.roundtrip-test.sqlite*
