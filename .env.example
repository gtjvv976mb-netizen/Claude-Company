# ---- required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- strongly recommended ----
# Public mainnet RPC is heavily rate-limited and will make the forensics agent
# flaky. Helius / Triton / QuickNode free tiers are all fine.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ---- optional ----
# Birdeye enriches holder + flow data. The desk runs without it, with lower
# confidence on the FLOW agent.
BIRDEYE_API_KEY=

# ---- desk configuration ----
DESK_EQUITY_USD=10000          # the desk's own PAPER book. Nothing derived from it
                               # reaches a wallet: since 2026-09-07 the desk publishes
                               # no size at all, and WALL-ST-E sizes from its own
                               # FIXED_SOL / MAX_SOL_PER_TRADE on your machine.
DESK_MAX_RISK_PCT=1.0          # max % of that paper equity risked on a single idea
DESK_MAX_CANDIDATES=8          # LLM agents run on at most this many per cycle
DESK_MIN_LIQUIDITY_USD=12000   # current hard screen floor
DESK_MIN_PAIR_AGE_HOURS=1.5    # current hard screen floor
# DESK_TARGET_SIZE_USD, DESK_MAX_RT_SLIPPAGE, DESK_MIN_STOP_DISTANCE_PCT,
# EXECUTOR_SLIPPAGE_BPS, EXECUTOR_MAX_FEE_SHARE_OF_STOP and DESK_AUTO_RISK_PCT were
# removed on 2026-09-07. The desk says WHAT and WHEN; it does not size trades, cap
# them, or judge what they cost. Setting any of them now does nothing. Every one of
# those judgments lives in the bot, at the size it is actually about to sign for —
# see executor/strategy.mjs and executor/poller.mjs.
DESK_SOL_USD_FALLBACK=103      # SOL price used to express a bot's declared per-trade
                               # cap in USD, so the exit ROUTE probe has an amount to
                               # quote at. A test amount; it limits nothing.

# ---- the CEO's door ----
# PUBLIC key only. Used to PREPARE an unsigned transaction for you to sign yourself.
# The hosted desk accepts only this public key. Never put a private key in hosted config.
DESK_WALLET_PUBKEY=
DESK_MODEL_CEO=claude-opus-5

# Prepare an unsigned swap transaction alongside the GMGN link. OFF by default and it
# should usually stay off: a transaction this desk composed, that you approve routinely,
# hands it the privilege that actually matters. The GMGN link is the safe path.
DESK_PREPARE_TX=0

# ---- floor leasing ----
# The PUBLIC address that receives $CLAUDECO for floors. Create it in your own wallet;
# the hosted leasing service accepts only this public address.
# Leasing stays closed until this is set.
TREASURY_OWNER=

CLAUDECO_MINT=HRkkxgaFDDmZ3qZX8xP5SiMRBNvFNVUUv4FJUjPCpump
CLAUDECO_DECIMALS=6
# Price per floor in whole tokens. Denominated in the token, not dollars, on purpose:
# a USD-pegged price read off a thin market is trivially manipulated.
FLOOR_PRICE_CLAUDECO=1000000

# ---- the penthouse desk ----
PENTHOUSE_ENABLED=1
PENTHOUSE_CYCLE_MINS=360     # research 4x a day; each cycle costs ~3 workups (~$5)
PENTHOUSE_MONITOR_MINS=10    # exit checks: prices and chain flags only, no model calls
PENTHOUSE_WORKUPS=3          # how many candidates get the expensive 14 seats per cycle
PENTHOUSE_TOP_N=5            # how many approved calls go on the sheet

# ---- the credit circuit breaker ----
# When a provider refuses for lack of credit, that provider's breaker opens and every
# further call to it is refused in-process, with no request. Measured 2026-09-06: a dry
# account cost ~1,250 refused requests an hour, because three concurrent workups keep
# firing seats after the cycle has already halted.
# After the cooldown, exactly ONE probe call is allowed through. If it succeeds the desk
# resumes on its own — no deploy, no restart — so this number IS the operator's
# time-to-recovery after a top-up. Bounded to 5s-15min.
# DIGITS ONLY. "60s" is Number()-NaN, and NaN survives Math.max/Math.min, so the breaker
# would silently become a no-op while the heartbeat reported half_open forever. A
# non-numeric value now falls back to the default and warns; this note is here so it
# never has to.
DESK_CREDIT_BREAKER_COOLDOWN_S=60
# How long that single probe may hold the slot before another caller may take it. Only
# matters if a probe never reports back; it must outlast the slowest real call (grok's
# x_search runs to 120s). Bounded to 30s-30min, and never below the cooldown.
DESK_CREDIT_BREAKER_PROBE_LEASE_S=300
# The breaker is for CREDIT and nothing else. If a probe keeps failing for some OTHER
# reason — a mis-set model after a retier, a revoked key, blocked egress — it stands down
# after this many consecutive non-credit probes and lets the real error surface loudly,
# rather than holding a funded desk silent behind an outage it no longer has.
DESK_CREDIT_BREAKER_STAND_DOWN_PROBES=2
