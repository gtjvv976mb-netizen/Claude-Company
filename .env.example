# ---- required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- strongly recommended ----
# Public mainnet RPC is heavily rate-limited and will make the forensics agent
# flaky. Helius / Triton / QuickNode free tiers are all fine.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ---- optional ----
# Birdeye enriches holder + flow data. The desk runs without it, with lower
# confidence on the FLOW agent.
BIRDEYE_API_KEY=

# ---- desk configuration ----
DESK_EQUITY_USD=10000          # notional book size used for position sizing
DESK_MAX_RISK_PCT=1.0          # max % of equity risked on a single idea
DESK_MAX_CANDIDATES=8          # LLM agents run on at most this many per cycle
DESK_MIN_LIQUIDITY_USD=75000   # hard screen floor
DESK_MIN_PAIR_AGE_HOURS=24     # hard screen floor
DESK_TARGET_SIZE_USD=500       # size used for the real slippage probe

# ---- the CEO's door ----
# PUBLIC key only. Used to PREPARE an unsigned transaction for you to sign yourself.
# Claude Co has no code path that accepts a private key or seed phrase. Never add one.
DESK_WALLET_PUBKEY=
DESK_MODEL_CEO=claude-opus-5

# Prepare an unsigned swap transaction alongside the GMGN link. OFF by default and it
# should usually stay off: a transaction this desk composed, that you approve routinely,
# hands it the privilege that actually matters. The GMGN link is the safe path.
DESK_PREPARE_TX=0
